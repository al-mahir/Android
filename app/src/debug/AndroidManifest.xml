<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug overlay: points the app at the cleartext exception for the local AI service. Merged into
  the debug build only, so the release manifest carries no networkSecurityConfig at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="UnusedAttribute">


        <activity
            android:name=".debug.LocalRecitationSpikeActivity"
            android:exported="true"
            android:label="Local recitation spike" />

    </application>

</manifest>
