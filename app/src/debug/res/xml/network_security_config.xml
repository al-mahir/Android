<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config.

  Allows cleartext for local AI service (no TLS on localhost/LAN).
  Also explicitly trusts both system and user CAs so devices with incomplete
  certificate stores (old trust anchors, missing Let's Encrypt root, etc.)
  can still reach HTTPS/WSS endpoints like api.quran.com and ngrok tunnels.

  This file lives in the `debug` source set on purpose: the release build
  never sees it. Shipping a blanket `usesCleartextTraffic` would mean
  shipping a microphone stream over plain HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- Trust the pre-installed system CAs -->
            <certificates src="system" />
            <!-- Also trust user-installed CAs (e.g. Charles Proxy cert for debugging) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
