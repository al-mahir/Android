<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only cleartext exception for the locally-run Al-Mahir AI service, which has no TLS.

  This file lives in the `debug` source set on purpose: the release build never sees it, so it
  cannot permit cleartext at all. Shipping a blanket `usesCleartextTraffic` would mean shipping a
  microphone stream over plain HTTP (docs/MOBILE_INTEGRATION.md §15).

  Hosts, per docs/MOBILE_INTEGRATION.md §2:
    10.0.2.2  — the Android emulator's alias for the host loopback
    10.0.3.2  — the Genymotion equivalent
    localhost — reachable after `adb reverse tcp:8100 tcp:8100`, which also avoids the firewall
    192.168.x — a physical device over Wi-Fi; the LAN IP is DHCP-assigned and will change
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">192.168.1.3</domain>
    </domain-config>
</network-security-config>
